# Copy to .env.local for local development. On Vercel set these in Project Settings > Environment Variables.

# MariaDB (mysql protocol). Add ?ssl={"rejectUnauthorized":true} style options via DATABASE_SSL below.
DATABASE_URL=mysql://photobooth:password@127.0.0.1:3306/photobooth_admin
# "true" to require TLS to the database (required for a database reached over the internet)
DATABASE_SSL=false

# 32 random bytes, base64. Encrypts stored secrets (R2 / Stripe / AI keys). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# First platform admin, used once by `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# Central template files (Platform Console > Template). The company's own R2 bucket, separate
# from customers' photo buckets. Leave empty in local development: files go to .local/catalog-assets.
# Required on Vercel before templates can be uploaded.
PLATFORM_R2_ACCOUNT_ID=
PLATFORM_R2_ENDPOINT=
PLATFORM_R2_BUCKET=
PLATFORM_R2_ACCESS_KEY_ID=
PLATFORM_R2_SECRET_ACCESS_KEY=
# Public base URL of that bucket (kiosks download template files from here)
PLATFORM_R2_PUBLIC_URL=

# Public URL of this Admin (used in the kiosk asset manifest when files are served locally)
ADMIN_PUBLIC_URL=
