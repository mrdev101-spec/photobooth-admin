# Copy to .env.local for local development. On Vercel set these in Project Settings > Environment Variables.

# MariaDB (mysql protocol). Add ?ssl={"rejectUnauthorized":true} style options via DATABASE_SSL below.
DATABASE_URL=mysql://photobooth:password@127.0.0.1:3306/photobooth_admin
# "true" to require TLS to the database (required for a database reached over the internet)
DATABASE_SSL=false

# 32 random bytes, base64. Encrypts stored secrets (R2 / Stripe / AI keys). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# First platform admin, used once by `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=

# Central template files (Platform Console > Template). The company's own R2 bucket, separate
# from customers' photo buckets. Leave empty in local development: files go to .local/catalog-assets.
# Required on Vercel before templates can be uploaded.
PLATFORM_R2_ACCOUNT_ID=
PLATFORM_R2_ENDPOINT=
PLATFORM_R2_BUCKET=
PLATFORM_R2_ACCESS_KEY_ID=
PLATFORM_R2_SECRET_ACCESS_KEY=
# Public base URL of that bucket (kiosks download template files from here)
PLATFORM_R2_PUBLIC_URL=

# Public URL of this Admin, https in production (Stripe return/webhook URLs, kiosk asset and
# phone-upload links). Required in production: the server refuses to start without it.
ADMIN_PUBLIC_URL=

# Email (sign-in codes for platform admins and shop owners) through Resend (resend.com):
# verify your sending domain there, then set the API key and the sender. Required in production;
# on a dev machine without them the code is printed in the server log.
RESEND_API_KEY=
EMAIL_FROM="SCLUO-DIO <no-reply@your-domain>"

# Housekeeping cron (/internal/cron/housekeeping, every 5 min on Vercel via vercel.json):
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>". Random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# Database pool per server instance (default 5). Raise on a long-running server with many kiosks.
# DATABASE_POOL_SIZE=5

# AI / Stripe endpoints: only for a proxy (or a stand-in provider in tests); https only in
# production. Keys are set in the Admin (Platform › ตั้งค่า AI / การชำระเงิน), never here.
# STRIPE_API_BASE_URL=https://api.stripe.com/v1
# AI_OPENAI_BASE_URL=https://api.openai.com/v1
# AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AI_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
